---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import FieldNotesCover from '../../components/FieldNotesCover.astro';
const posts = (await getCollection('blog', ({ data }) => data.status !== 'draft')).sort((a, b) => {
  const left = a.data.status === 'published' ? a.data.publishedAt : '';
  const right = b.data.status === 'published' ? b.data.publishedAt : '';
  return right.localeCompare(left) || a.data.title.localeCompare(b.data.title);
});
const [featured, ...others] = posts;
---
<SiteLayout title="Blogs" description="Build logs, workshop notes, and useful discoveries from AWS student builders at UT Arlington.">
  <section class="page interior-page">
    <div class="page-heading"><h1>Field notes</h1><p>Build logs and notes from the group.</p></div>
    {featured ? (
      <div class="interior-content blog-feature">
        <FieldNotesCover />
        <article class="blog-preview">
          <div class="eyebrow">{featured.data.status === 'sample' ? 'SAMPLE ARTICLE' : featured.data.category.toUpperCase()}</div>
          <h2>{featured.data.title}</h2><p>{featured.data.summary}</p>
          <a class="text-link" href={`/blog/${featured.id}/`}>{featured.data.status === 'sample' ? 'Read the sample' : 'Read the story'} <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    ) : <div class="interior-content blog-empty"><FieldNotesCover /><p>Our first field notes are on their way.</p></div>}
    {others.length > 0 && <section class="interior-content more-posts" aria-label="More field notes">{others.map(post => <a class="history-row" href={`/blog/${post.id}/`}><div><span class="eyebrow">{post.data.status === 'sample' ? 'SAMPLE ARTICLE' : post.data.category.toUpperCase()}</span><h2>{post.data.title}</h2></div><span>Read ↗</span></a>)}</section>}
  </section>
</SiteLayout>

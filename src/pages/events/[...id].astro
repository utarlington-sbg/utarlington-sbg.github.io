---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { eventPhase, formatEventDate } from '../../lib/events';

export async function getStaticPaths() {
  return (await getCollection('events', ({ data }) => data.kind === 'scheduled')).map(event => ({ params: { id: event.id }, props: { event } }));
}
interface Props { event: CollectionEntry<'events'> }
const { event } = Astro.props;
const { Content } = await render(event);
---
<SiteLayout title={event.data.title} description={`Join AWS student builders at UT Arlington for ${event.data.title}.`}>
  <article class="reading-page">
    <a class="text-link reading-back" href="/events/">← All events</a>
    <header><div class="eyebrow">{eventPhase(event.data) === 'past' ? 'PAST EVENT' : 'UPCOMING EVENT'}</div><h1>{event.data.title}</h1>
      {event.data.kind === 'scheduled' && <p class="event-detail-facts"><time datetime={event.data.startsAt}>{formatEventDate(event.data.startsAt)}</time><br />{event.data.location}</p>}
    </header>
    <div class="prose"><Content /></div>
    <a class="button lavender" href={event.data.rsvp}>{eventPhase(event.data) === 'past' ? 'View on Meetup' : 'RSVP on Meetup'} <span aria-hidden="true">↗</span></a>
  </article>
</SiteLayout>

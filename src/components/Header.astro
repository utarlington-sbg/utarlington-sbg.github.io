---
import { sitePath } from '../lib/paths';
import Logo from './Logo.astro';
import { navigation, site } from '../data/site';
const path = Astro.url.pathname;
---
<header class="header" data-header>
  <a class="brand" href={sitePath('/')} aria-label="AWS at UTA — Home"><Logo /></a>
  <nav aria-label="Main navigation">
    {navigation.map(({ href, label }) => (
      <a href={sitePath(href)} aria-current={href === '/' ? path === sitePath('/') ? 'page' : undefined : path.startsWith(sitePath(href)) ? 'page' : undefined}>{label}</a>
    ))}
    <a href={site.links.meetup}>Meetup <span aria-hidden="true">↗</span></a>
  </nav>
</header>

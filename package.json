{
  "name": "uta-student-builders",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "test": "npm run test:content && npm run test:browser",
    "test:content": "node --experimental-strip-types --test tests/content.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
